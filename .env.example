APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Leave this false. With APP_DEBUG=true a deployed site answers any uncaught
# exception with a page that prints the stack trace and the whole contents of
# this file — the database password, APP_KEY, the mail and PhilSMS credentials.
# Set it to true only on a local machine, and never on the server.
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true on the server, once it is served over HTTPS: without it the session
# cookie is also sent over plain HTTP, where it can be read off the wire.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# ── PESO Job Fair ──
JOBFAIR_MIN_EMPLOYERS=3
# How long an employer has to answer a job fair invitation before it lapses.
# PESO Job Fair staff, 2026-08-23: a week, after which the staff looks for
# someone else. A late answer is still accepted.
JOBFAIR_CONFIRM_DAYS=7
# Days before an invitation lapses that the employer is reminded. Counted from
# the invitation's own deadline, not from the event date.
JOBFAIR_REMINDER_DAYS=2
# Days before the event that the confirmed roster is submitted to DOLE. The
# office's deadline to have the roster full, not a cut-off for employers.
JOBFAIR_DOLE_CUTOFF_DAYS=10
# How far ahead a job fair event has to be created. PESO Job Fair staff,
# 2026-08-23: a fair is planned a month out, and the invitations go to the
# employers the day it is created.
JOBFAIR_CREATE_LEAD_DAYS=30
# Days before the event that approved job fair postings become visible to
# jobseekers. The event is a month out, so opening them at once would leave
# jobseekers looking at vacancies they cannot act on for four weeks.
JOBFAIR_OPEN_DAYS=5

# ── PESO Office ──
# Shown to an employer who cannot reach their registered email. Set the real
# number before go-live — the default is a placeholder.
PESO_CONTACT_NUMBER="(088) 000-0000"
PESO_OFFICE_HOURS="Monday to Friday, 8:00 AM – 5:00 PM"

# ── PESO Scheduling ──
# How many different companies the PESO Office can host for in-house interviews
# on one day. LRA staff, 2026-08-23: two. The room sets this, so it applies to
# local and overseas bookings alike.
PESO_INHOUSE_DAILY_COMPANIES=2
# Days after an in-house interview before its report is shown to staff, giving
# the employer time to decide on the people they saw.
PESO_INHOUSE_REPORT_DAYS=7

# ── Employer activity ──
# Months with no new job vacancy before the office emails the employer to ask
# what happened. A company that shuts down never says so, and the account looks
# the same as one that is merely between hires.
PESO_EMPLOYER_INACTIVE_MONTHS=1
# Days the employer has to answer inside the system before the account is
# disabled. Staff switch it back on after reading the reason.
PESO_EMPLOYER_INACTIVITY_GRACE_DAYS=7

# ── PhilSMS ──
PHILSMS_ENABLED=false
PHILSMS_TOKEN=
PHILSMS_SENDER_ID=PESO

# NSRP OCR service (ocr_service/ — start with: ocr_service/venv/Scripts/python.exe ocr_service/service.py)
OCR_SERVICE_URL=http://127.0.0.1:8001
OCR_SERVICE_TIMEOUT=180
